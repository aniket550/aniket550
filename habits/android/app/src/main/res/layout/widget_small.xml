<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget, small (2 x 2): one glance and one tap target, like Apple's small widgets.
     The ring, the count and what is next; a tap opens the app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <ImageView
        android:id="@+id/w_ring"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/w_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:letterSpacing="-0.02"
        android:singleLine="true"
        android:text="@string/app_name"
        android:textColor="@color/widget_ink"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true"
        android:textColor="@color/widget_secondary"
        android:textSize="12sp" />
</LinearLayout>
